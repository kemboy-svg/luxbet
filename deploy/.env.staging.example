# LuxBet staging environment (DigitalOcean Droplet). Copy to /opt/luxbet/.env
# on the server, fill in every CHANGE_ME, and `chmod 600` it. Never commit it.
#
# Demo only: this file must never contain payment-provider credentials
# (Stripe, PayPal, M-Pesa, ...) or production game-provider keys.
# `php artisan luxbet:preflight` fails the deploy if it finds any.

APP_NAME=LuxBet
APP_ENV=staging
APP_KEY=CHANGE_ME_base64_key_from_php_artisan_key_generate_show
APP_DEBUG=false
APP_URL=https://staging.example.com

# Caddy (HTTPS) settings
LUXBET_DOMAIN=staging.example.com
ACME_EMAIL=you@example.com

# Image tag deployed (set by scripts/deploy.sh)
LUXBET_IMAGE_TAG=

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=luxbet
DB_USERNAME=luxbet
DB_PASSWORD=CHANGE_ME_long_random

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_long_random

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Transactional email (e.g. a staging SMTP account). Sandbox inboxes are fine.
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="no-reply@staging.example.com"
MAIL_FROM_NAME="LuxBet (staging)"

LUXBET_ENVIRONMENT_MODE=staging
LUXBET_REQUIRE_EMAIL_VERIFICATION=false
LUXBET_CSP_ENABLED=true
LUXBET_CSP_REPORT_ONLY=false
LUXBET_HSTS_MAX_AGE=31536000
