# Backup settings for scripts/backup-db.sh and scripts/restore-db.sh.
# Copy to /opt/luxbet/backup.env and `chmod 600` it. Kept apart from .env so
# the application containers never see backup or Spaces credentials.

# Passphrase used to encrypt dumps (AES-256). Keep a copy outside the Droplet
# (e.g. a password manager): without it backups cannot be restored.
BACKUP_PASSPHRASE=CHANGE_ME_long_random
BACKUP_DIR=/var/backups/luxbet
BACKUP_RETENTION_DAYS=14

# Optional off-site copy in DigitalOcean Spaces (S3-compatible). Leave
# SPACES_BUCKET empty to keep backups on the Droplet only.
SPACES_BUCKET=
SPACES_REGION=fra1
SPACES_KEY=
SPACES_SECRET=
